(require 'doom-themes)

(def-doom-theme doom-laland-light
  "laland (light): blue-tinted ground, vivid accents, pink in the magenta slot."
  :family 'doom-laland
  :background-mode 'light

  ;; name        default   256       16
  ((bg         '("#f5f7fc" "#f5f7fc" "black"))
   (bg-alt     '("#e9edf5" "#e9edf5" "black"))
   (base0      '("#fdfdff" "#fdfdff" "black"))
   (base1      '("#eff2f9" "#eff2f9" "brightblack"))
   (base2      '("#e4e8f2" "#e4e8f2" "brightblack"))
   (base3      '("#dde1ec" "#dde1ec" "brightblack"))
   (base4      '("#b2b7c5" "#b2b7c5" "brightblack"))
   (base5      '("#5e6886" "#5e6886" "brightblack"))
   (base6      '("#555d75" "#555d75" "brightblack"))
   (base7      '("#3c4253" "#3c4253" "brightblack"))
   (base8      '("#1e212b" "#1e212b" "white"))
   (fg         '("#222633" "#222633" "brightwhite"))
   (fg-alt     '("#5e6886" "#5e6886" "white"))
   (red        '("#891622" "#891622" "red"))
   (orange     '("#8c3e14" "#8c3e14" "brightred"))
   (green      '("#247448" "#247448" "green"))
   (teal       '("#2a8080" "#2a8080" "brightgreen"))
   (yellow     '("#8f6711" "#8f6711" "yellow"))
   (blue       '("#0e4481" "#0e4481" "brightblue"))
   (dark-blue  '("#c3cfe2" "#c3cfe2" "blue"))
   (magenta    '("#bd2f9a" "#bd2f9a" "brightmagenta"))
   (violet     '("#431575" "#431575" "magenta"))
   (cyan       '("#2b8193" "#2b8193" "brightcyan"))
   (dark-cyan  '("#3d6b79" "#3d6b79" "cyan"))

   (grey                 base4)
   (highlight            magenta)
   (vertical-bar         base2)
   (selection            dark-blue)
   (builtin              orange)
   (comments             base5)
   (doc-comments         (doom-darken base5 0.15))
   (constants            cyan)
   (functions            green)
   (keywords             magenta)
   (methods              teal)
   (operators            violet)
   (type                 violet)
   (strings              yellow)
   (variables            (doom-darken magenta 0.25))
   (numbers              violet)
   (region               (doom-blend magenta bg 0.16))
   (error                red)
   (warning              yellow)
   (success              green)
   (vc-modified          orange)
   (vc-added             green)
   (vc-deleted           red)
   (modeline-bg          (doom-darken bg-alt 0.04))
   (modeline-bg-inactive bg-alt))

  ;;;; Face overrides
  (((line-number &override) :foreground base4)
   ((line-number-current-line &override) :foreground highlight :weight 'bold)
   (mode-line :background modeline-bg :foreground fg)
   (mode-line-inactive :background modeline-bg-inactive :foreground base5)
   (mode-line-emphasis :foreground highlight)
   ;;;; doom-modeline
   (doom-modeline-bar :background highlight)
   (doom-modeline-buffer-file :inherit 'mode-line-buffer-id :weight 'bold)
   (doom-modeline-buffer-path :inherit 'mode-line-emphasis :weight 'bold)
   (doom-modeline-buffer-project-root :foreground green :weight 'bold)
   ;;;; solaire-mode
   (solaire-mode-line-face :inherit 'mode-line :background modeline-bg)
   (solaire-mode-line-inactive-face :inherit 'mode-line-inactive :background modeline-bg-inactive))

  ;;;; Variable overrides
  ())

;;; doom-laland-light-theme.el ends here
