(require 'doom-themes)

(def-doom-theme doom-laland
  "laland (dark): blue-tinted ground, vivid accents, pink in the magenta slot."
  :family 'doom-laland
  :background-mode 'dark

  ;; name        default   256       16
  ((bg         '("#1b2236" "#1b2236" "black"))
   (bg-alt     '("#141b2e" "#141b2e" "black"))
   (base0      '("#0f1425" "#0f1425" "black"))
   (base1      '("#171d31" "#171d31" "brightblack"))
   (base2      '("#20273c" "#20273c" "brightblack"))
   (base3      '("#252d45" "#252d45" "brightblack"))
   (base4      '("#8590ad" "#8590ad" "brightblack"))
   (base5      '("#a3b4e7" "#a3b4e7" "brightblack"))
   (base6      '("#b6c2e4" "#b6c2e4" "brightblack"))
   (base7      '("#c8d0e4" "#c8d0e4" "brightblack"))
   (base8      '("#e7eaf3" "#e7eaf3" "white"))
   (fg         '("#edf1f9" "#edf1f9" "brightwhite"))
   (fg-alt     '("#a3b4e7" "#a3b4e7" "white"))
   (red        '("#ff7d7d" "#ff7d7d" "red"))
   (orange     '("#ff9b51" "#ff9b51" "brightred"))
   (green      '("#40e779" "#40e779" "green"))
   (teal       '("#41dfd7" "#41dfd7" "brightgreen"))
   (yellow     '("#d2bc79" "#d2bc79" "yellow"))
   (blue       '("#8ed2ff" "#8ed2ff" "brightblue"))
   (dark-blue  '("#2f5492" "#2f5492" "blue"))
   (pink-ui    '("#ff93dd" "#ff93dd" "brightmagenta"))
   (magenta    '("#ff86da" "#ff86da" "brightmagenta"))
   (violet     '("#b89eff" "#b89eff" "magenta"))
   (cyan       '("#43e3eb" "#43e3eb" "brightcyan"))
   (dark-cyan  '("#55919c" "#55919c" "cyan"))

   (grey                 base4)
   (highlight            pink-ui)
   (vertical-bar         (doom-darken base1 0.1))
   (selection            dark-blue)
   (builtin              orange)
   (comments             base5)
   (doc-comments         (doom-lighten base5 0.25))
   (constants            cyan)
   (functions            green)
   (keywords             magenta)
   (methods              teal)
   (operators            violet)
   (type                 violet)
   (strings              yellow)
   (variables            (doom-lighten magenta 0.6))
   (numbers              violet)
   (region               (doom-blend pink-ui bg 0.22))
   (error                red)
   (warning              (doom-lighten yellow 0.45))
   (success              green)
   (vc-modified          orange)
   (vc-added             green)
   (vc-deleted           red)
   (modeline-bg          (doom-darken bg-alt 0.1))
   (modeline-bg-inactive bg-alt))

  ;;;; Face overrides
  (((line-number &override) :foreground base4)
   ((line-number-current-line &override) :foreground highlight :weight 'bold)
   (mode-line :background modeline-bg :foreground fg)
   (mode-line-inactive :background modeline-bg-inactive :foreground base5)
   (mode-line-emphasis :foreground highlight)
   ;;;; doom-modeline
   (doom-modeline-bar :background highlight)
   (doom-modeline-buffer-file :inherit 'mode-line-buffer-id :weight 'bold)
   (doom-modeline-buffer-path :inherit 'mode-line-emphasis :weight 'bold)
   (doom-modeline-buffer-project-root :foreground green :weight 'bold)
   ;;;; solaire-mode
   (solaire-mode-line-face :inherit 'mode-line :background modeline-bg)
   (solaire-mode-line-inactive-face :inherit 'mode-line-inactive :background modeline-bg-inactive))

  ;;;; Variable overrides
  ())

;;; doom-laland-theme.el ends here
